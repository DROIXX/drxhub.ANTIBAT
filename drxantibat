local function setToggle(knob, bg, enabled, big)
    local onPos = big and UDim2.new(1, -20, 0.5, -8) or UDim2.new(1, -17, 0.5, -7)
    local offPos = big and UDim2.new(0, 4, 0.5, -8) or UDim2.new(0, 3, 0.5, -7)
    TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = enabled and onPos or offPos,
        BackgroundColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 220, 220),
    }):Play()
    TweenService:Create(bg, TweenInfo.new(0.18), {
        BackgroundColor3 = enabled and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(60, 60, 60),
    }):Play()
end

local function toggleAntiBat()
    AntiBatEnabled = not AntiBatEnabled
    if AntiBatEnabled then
        startAntiBat()
        ABStatus.Text = "ON"
        ABStatus.TextColor3 = Color3.fromRGB(0, 230, 100)
    else
        stopAntiBat()
        ABStatus.Text = "OFF"
        ABStatus.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
    setToggle(AntiBatKnob, AntiBatToggleBg, AntiBatEnabled, true)
end

local function toggleInfJump()
    InfiniteJumpEnabled = not InfiniteJumpEnabled
    if not InfiniteJumpEnabled then IsJumpingHold = false end
    setToggle(InfJumpKnob, InfJumpToggleBg, InfiniteJumpEnabled, false)
end

